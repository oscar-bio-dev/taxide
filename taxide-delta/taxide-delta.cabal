cabal-version:      3.0
name:               taxide-delta
version:            0.1.0.0
synopsis:           Parser y serializador canónico de alta fidelidad para el formato DELTA
description:        Analizador combinatorio en Megaparsec y pretty-printer canónico para SPECS, CHARS e ITEMS.
license:            Apache-2.0
author:             TAXIDE Core Architecture Team
maintainer:         core@taxide.org
category:           Bioinformatics, Parsing, Scientific Computing
build-type:         Simple

common common-options
    default-language:   GHC2021
    default-extensions:
        StrictData
        OverloadedStrings
        DeriveGeneric
        DeriveAnyClass
        BangPatterns
        TypeFamilies
        GADTs
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

library
    import:             common-options
    hs-source-dirs:     src
    exposed-modules:
        Taxide.Delta.Parser.Lexer
        Taxide.Delta.Parser.Specs
        Taxide.Delta.Parser.Chars
        Taxide.Delta.Parser.Items
        Taxide.Delta.Serializer.Specs
        Taxide.Delta.Serializer.Chars
        Taxide.Delta.Serializer.Items
        Taxide.Delta.Pipeline
    build-depends:
        base >= 4.18 && < 5,
        taxide-core,
        text >= 2.0,
        bytestring >= 0.11,
        containers >= 0.6,
        vector >= 0.13,
        deepseq >= 1.4,
        megaparsec >= 9.3,
        parser-combinators >= 1.3,
        prettyprinter >= 1.7,
        filepath >= 1.4,
        directory >= 1.3

executable taxide-fmt
    import:             common-options
    hs-source-dirs:     app
    main-is:            Main.hs
    build-depends:
        base >= 4.18 && < 5,
        taxide-core,
        taxide-delta,
        text >= 2.0,
        optparse-applicative >= 0.18,
        filepath >= 1.4,
        directory >= 1.3

test-suite taxide-delta-test
    import:             common-options
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test
    main-is:            Main.hs
    build-depends:
        base >= 4.18 && < 5,
        taxide-core,
        taxide-delta,
        text >= 2.0,
        containers >= 0.6,
        tasty >= 1.4,
        tasty-hunit >= 0.10,
        tasty-hedgehog >= 1.4,
        hedgehog >= 1.2,
        megaparsec >= 9.3
